# ─────────────────────────────────────────────────────────
# CHEMINS COMMUNS — Test Environment
# Used for running tests locally: docker compose --env-file .env.test up -d
# ─────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=common_trails
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Backend ───────────────────────────────────────────────
JWT_SECRET=test-secret

# Stubs enabled — no real external calls
TEST_MODE=true

# ── Frontend ──────────────────────────────────────────────
API_URL=http://localhost:8787
MAP_STYLE_URL=
