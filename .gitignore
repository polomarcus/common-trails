# real Strava/GPX archives dropped into data/ for local ingest tests (can be 100s of MB)
data/*.zip
# Valhalla map-matching tiles + supporting files (generated by the
# valhalla docker service from PBFs in ./data; see docs/valhalla-ops.md).
data/valhalla_tiles/
data/valhalla_tiles.tar
data/valhalla.json
data/admin_data/
data/timezone_data/
data/duplicateways.txt
data/file_hashes.txt
data/landmarks.sqlite*
# DFCI IGN cache (14+ MB, generated by scripts/extract_dfci_ign.py)
backend/app/data/dfci_ign_edges.json
# PMTiles heatmap (generated by python -m app.jobs.build_pmtiles, 10MB-200MB)
frontend/public/*.pmtiles
# Pre-built routing graphs (generated by ./wasm-router/build.sh --prebuild)
frontend/public/*.fgraph
data/*.osm.pbf
data/_archive_pbf/
.claude/worktrees/

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Playwright last-run artifacts (auto-generated; not source-controlled)
test-results/
frontend/test-results/

# Ad-hoc virtualenv for scripts/extract_dfci_ign.py (recreate locally with
# python3 -m venv .venv-dfci)
.venv-dfci/
.venv*/
venv/

# Local env overrides — NEVER commit (only .env.example / .env.test are tracked)
.env.local
**/.env.local

# Personal / test trace corpus — a user's own Strava export is PRIVATE location
# data and must never be published. Provide your own locally for golden runs.
data/strava-export/
data/gpx/

# Internal AI-agent tooling / instructions — kept locally, not part of the
# public repo (Claude Code config, BMAD workflow scaffolding, agent guides).
.claude/
_bmad/
CLAUDE.md
AGENTS.md
