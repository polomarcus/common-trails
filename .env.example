# ─────────────────────────────────────────────────────────
# CHEMINS COMMUNS — Environment Variables Example
# Copy to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=common_trails
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Backend ───────────────────────────────────────────────
# Secret used to sign JWT tokens — change in production!
JWT_SECRET=change-me-in-production

# Set to true to use stubs instead of real external calls
TEST_MODE=false

# ── Strava OAuth (official API only) ─────────────────────
# Set to true to enable Strava integration
# Importing Strava heatmaps is FORBIDDEN — only personal activities
ENABLE_STRAVA_INTEGRATION=false
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8787/integrations/strava/callback

# ── Frontend ──────────────────────────────────────────────
# URL of the backend API (used at runtime by the browser)
API_URL=http://localhost:8787

# Optional: custom MapLibre style URL (leave empty for offline/inline style)
MAP_STYLE_URL=

# ── Sentry (optional — error tracking) ────────────────────
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/yyy
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/yyy

# ── Async heat compute via Cloud Tasks (production only) ──
# When unset, /gpx/upload runs heat compute inline in the request thread
# (legacy behavior). Set all four vars to flip on the async path:
#   GOOGLE_CLOUD_PROJECT=my-gcp-project
#   CLOUD_TASKS_LOCATION=europe-west1
#   CLOUD_TASKS_QUEUE=common-trails-heat-compute-prod
#   CLOUD_TASKS_INVOKER_SA=common-trails-tasks-invoker@my-gcp-project.iam.gserviceaccount.com
#   INTERNAL_HEAT_HANDLER_URL=https://common-trails-api-prod-xxx.run.app/internal/ingest/heat

# ── Map-matching at ingest ──
# The in-process Viterbi trajectory HMM (SPATIAL_HMM_ENABLED, default ON) is
# the sole map-matcher: GPS traces are snapped to the OSM network in-process.
# SPATIAL_HMM_ENABLED=true
