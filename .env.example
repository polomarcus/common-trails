# ─────────────────────────────────────────────────────────
# CHEMINS COMMUNS — Environment Variables Example
# Copy to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=common_trails
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Backend ───────────────────────────────────────────────
# Secret used to sign JWT tokens — change in production!
JWT_SECRET=change-me-in-production

# Set to true to use stubs instead of real external calls
TEST_MODE=false

# ── Frontend ──────────────────────────────────────────────
# URL of the backend API (used at runtime by the browser)
API_URL=http://localhost:8787

# Optional: custom MapLibre style URL (leave empty for offline/inline style)
MAP_STYLE_URL=

# ── Sentry (optional — error tracking) ────────────────────
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/yyy
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/yyy

# ── Community map rebuild (production only) ──
# When unset, an upload stores the activity and nothing is triggered (rebuild
# the PMTiles by hand with `make pmtiles`). Set these to request a (debounced)
# run of the build-pmtiles Cloud Run Job after uploads (run_jobs.py):
#   GCP_PROJECT=my-gcp-project
#   GCP_REGION=europe-west1
#   BUILD_PMTILES_JOB_NAME=common-trails-build-pmtiles-prod
